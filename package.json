{
  "name": "obsidian-gpt-pages-importer",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:public": "node scripts/check-public-fixtures.mjs",
    "check": "npm run check:public && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "24.19.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
